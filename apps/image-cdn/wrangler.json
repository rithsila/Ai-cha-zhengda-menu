{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-cha-menu-images",
  "compatibility_date": "2024-09-23",
  "main": "src/index.ts",
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "aicha-menu-images"
    }
  ],
  "routes": [
    {
      "pattern": "menu-img.aichazhengdaarakawa.com",
      "custom_domain": true
    }
  ]
}
