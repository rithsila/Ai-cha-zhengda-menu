generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  telegramUserId String  @id
  phoneNumber    String?
  username       String?
  firstName      String?
  lastName       String?
  loyaltyPoints  Int     @default(0)
  orders         Order[]
}

model Branch {
  id       String  @id @default(uuid())
  name     String
  address  String
  isActive Boolean @default(true)
  orders   Order[]
}

model MenuItem {
  id          String          @id @default(uuid())
  brand       String
  category    String
  name        String
  description String?
  basePrice   Float
  image       String?
  isSoldOut   Boolean         @default(false)
  modifiers   ModifierGroup[]
  orderItems  OrderItem[]
}

model ModifierGroup {
  id         String           @id @default(uuid())
  name       String
  type       String           // "single" | "multiple"
  required   Boolean          @default(false)
  menuItemId String
  menuItem   MenuItem         @relation(fields: [menuItemId], references: [id])
  options    ModifierOption[]
}

model ModifierOption {
  id              String        @id @default(uuid())
  name            String
  priceDelta      Float         @default(0)
  modifierGroupId String
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id])
}

model Order {
  id            String      @id @default(uuid())
  totalAmount   Float
  paymentMethod String      // "khqr" | "cash"
  status         String      @default("pending") // "pending" | "paid" | "preparing" | "ready"
  createdAt      DateTime    @default(now())
  pickupCode     String?
  telegramUserId String?
  user           User?       @relation(fields: [telegramUserId], references: [telegramUserId])
  orderType      String      @default("pickup") // "pickup" | "delivery"
  deliveryAddress String?
  branchId       String?
  branch         Branch?     @relation(fields: [branchId], references: [id])
  pointsEarned   Int         @default(0)
  discountApplied Float      @default(0)
  items          OrderItem[]
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  quantity   Int      @default(1)
  price      Float
  modifiers  String   // JSON string of selected modifiers
}
