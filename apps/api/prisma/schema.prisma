generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  telegramUserId String   @id
  phoneNumber    String?
  username       String?
  firstName      String?
  lastName       String?
  loyaltyPoints  Int      @default(0)
  contactName    String?  // name to call at the door
  building       String?  // Arakawa building, "A".."G"
  roomNumber     String?  // 4 digits, "1110" = floor 11, room 10
  tier           String   @default("standard") // "standard" (untrusted/new) | "gold" (trusted/VIP)
  luckyTickets   Int      @default(0)
  trustNotes     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  orders         Order[]
  prizeClaims    PrizeClaim[]
}

model Branch {
  id       String  @id @default(uuid())
  name     String
  address  String
  isActive Boolean @default(true)
  orders   Order[]
}

model MenuItem {
  id          String          @id @default(uuid())
  brand       String
  category    String
  name        String
  description String?
  basePrice   Float
  image       String?
  isSoldOut   Boolean         @default(false)
  isActive    Boolean         @default(true)
  earnsStamp  Boolean         @default(true)
  canClaim    Boolean         @default(false)
  modifiers   ModifierGroup[]
  orderItems  OrderItem[]
}

model ModifierGroup {
  id         String           @id @default(uuid())
  key        String           // stable id from the static catalog, e.g. "toppings"
  name       String
  type       String           // "single" | "multiple"
  required   Boolean          @default(false)
  menuItemId String
  menuItem   MenuItem         @relation(fields: [menuItemId], references: [id])
  options    ModifierOption[]

  @@unique([menuItemId, key])
}

model ModifierOption {
  id              String        @id @default(uuid())
  key             String        // stable id from the static catalog, e.g. "boba"
  name            String
  priceDelta      Float         @default(0)
  modifierGroupId String
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id])

  @@unique([modifierGroupId, key])
}

model Order {
  id            String      @id @default(uuid())
  totalAmount   Float
  paymentMethod String      // "khqr" | "cash"
  status         String      @default("pending") // "pending" | "paid" | "preparing" | "ready"
  transactionId  String?     @unique
  paymentExpiresAt DateTime? // KHQR is valid ~15 minutes; null for cash orders
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @default(now()) @updatedAt
  pickupCode     String?
  telegramUserId String?
  user           User?       @relation(fields: [telegramUserId], references: [telegramUserId])
  orderType      String      @default("pickup") // "pickup" | "delivery"
  // Snapshot of where the order actually went — the user profile may change later.
  deliveryAddress String?
  deliveryBuilding String?
  deliveryRoom     String?
  contactName      String?
  contactPhone     String?
  deliveryFee      Float      @default(0)
  deliveryLat     Float?
  deliveryLng     Float?
  branchId       String?
  branch         Branch?     @relation(fields: [branchId], references: [id])
  pointsEarned   Int         @default(0)
  discountApplied Float      @default(0)
  pointsRedeemed Int         @default(0)
  pointsSettled  Boolean     @default(false)
  cancelReason   String?
  items          OrderItem[]
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  quantity   Int      @default(1)
  price      Float
  modifiers  String   // JSON string of selected modifiers
}

model Reward {
  id          String   @id @default(uuid())
  name        String
  description String?
  pointsCost  Int
  image       String?
  isActive    Boolean  @default(true)
}

model SystemConfig {
  key   String @id
  value String
}

model StaffAccount {
  id             String   @id @default(uuid())
  telegramUserId String?  @unique
  phoneNumber    String?  @unique
  name           String   // Staff or manager name/label
  role           String   @default("staff") // "staff" | "manager"
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
}

model FeedbackReport {
  id             String   @id @default(uuid())
  telegramUserId String?
  userName       String?
  userPhone      String?
  message        String
  status         String   @default("new") // "new" | "reviewed" | "resolved"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
}

model PrizeClaim {
  id                 String    @id @default(uuid())
  code               String    @unique // e.g. "LUCKY-XXXXXX"
  telegramUserId     String
  user               User      @relation(fields: [telegramUserId], references: [telegramUserId], onDelete: Cascade)
  prizeId            String?
  prizeName          String
  prizeIcon          String    @default("🎁")
  prizeType          String    @default("item") // "item" | "drink" | "snack" | "discount"
  status             String    @default("pending") // "pending" | "claimed" | "expired"
  source             String    @default("wheel_spin") // "wheel_spin" | "manager_draw"
  expiresAt          DateTime?
  claimedAt          DateTime?
  claimedByStaffId   String?
  claimedByStaffName String?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt

  @@index([telegramUserId])
  @@index([status])
}

