# ===== Database =====
# SQLite database file. Keep this value as-is for local development.
DATABASE_URL="file:./dev.db"

# ===== Telegram Bot =====
# Get this token from @BotFather in Telegram.
# If empty, the bot is skipped (the API still runs).
TELEGRAM_BOT_TOKEN=""

# Public URL where the customer menu app (apps/menu) is hosted.
# The bot uses it for the "Open Menu" button.
# Must be HTTPS for Telegram to accept it.
WEBAPP_URL=""

# ===== ABA PayWay =====
# Get these from your ABA PayWay merchant account (sandbox or production).
# Without real values, payment creation fails and only Cash checkout works.
ABA_MERCHANT_ID=""
ABA_API_KEY=""

# Sandbox URL for testing. Change to the production URL when going live.
ABA_BASE_URL="https://checkout-sandbox.payway.com.kh"

# Secret used to verify payment webhooks from ABA.
# If empty, webhooks are REJECTED with 503 -- an unverified webhook could let
# anyone mark an order as paid. During development, use the status endpoint
# (GET /api/payment/aba/status/:orderId) instead of webhooks.
ABA_WEBHOOK_SECRET=""

# Public URL ABA sends the customer back to after paying. Leave empty for local
# development; webhooks cannot reach localhost anyway.
ABA_WEBHOOK_URL=""

# ===== Server =====
# Port for the API server. Default is 4000.
PORT=4000

# ===== Staff Dashboard PINs (server-side check) =====
# PIN for the staff dashboard lock screen.
# In production BOTH pins are REQUIRED: the server refuses to start without
# them, so it can never fall back to the published defaults (1234 / 9999).
# Outside production the defaults are used and a warning is printed.
# Staff and managers log in at POST /api/auth/staff-login and then send
# `Authorization: Bearer <token>`. The old x-manager-pin header no longer works.
STAFF_PIN="1234"
# PIN for Manager Mode (analytics, rewards, loyalty, config).
MANAGER_PIN="9999"

# ===== Browser origins allowed to call this API (CORS) =====
# Comma-separated list of exact origins. Leave empty for the development
# default: http://localhost:5173 (menu app) and http://localhost:5174 (staff app).
# In production set the real HTTPS origins, for example:
# CORS_ORIGINS="https://menu.example.com,https://staff.example.com"
CORS_ORIGINS=""

# ===== Development-only customer identity escape hatch =====
# Customers normally prove who they are with the Telegram Mini App header
# `X-Telegram-Init-Data`, which is signed with TELEGRAM_BOT_TOKEN, or with
# `Authorization: Bearer <token>` from the Telegram login callback.
# With no bot token there is nothing to check a signature against. Setting this
# to 1 makes the API trust a plain `X-Telegram-User-Id` header instead, so you
# can test the app locally. ANY caller can then act as ANY customer.
# It only works when TELEGRAM_BOT_TOKEN is empty and NODE_ENV is not
# "production" -- it cannot be switched on in production at all.
ALLOW_UNVERIFIED_TELEGRAM=""
