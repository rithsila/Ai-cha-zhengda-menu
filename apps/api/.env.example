# ===== Database =====
# SQLite database file. Use file:./dev.db for local dev, file:./prod.db for production.
DATABASE_URL="file:./dev.db"

# ===== Server Environment =====
NODE_ENV="development"
PORT=4000

# ===== Telegram Bot =====
# Get this token from @BotFather in Telegram.
# If empty, the bot is skipped (the API still runs).
TELEGRAM_BOT_TOKEN=""

# Public URL where the customer menu app (apps/menu) is hosted.
# The bot uses it for the "Open Menu" button.
# Must be HTTPS for Telegram Mini App to work.
WEBAPP_URL="https://menu.aichazhengdaarakawa.com"

# Public URL where the staff portal app (apps/staff) is hosted.
STAFF_APP_URL="https://staff.aichazhengdaarakawa.com"

# ===== Telegram Role Authorization (comma-separated Telegram User IDs) =====
# Managers have access to Analytics, Loyalty settings, Catalog editing, and Order status.
MANAGER_TELEGRAM_IDS=""
# Staff have access to Kitchen Order Management and Sold Out toggles.
STAFF_TELEGRAM_IDS=""

# ===== Phone OTP & SMS Delivery (Plasgate) =====
# Admin/Manager authorized phone numbers (comma-separated, e.g., "+85512345678,070433443")
ADMIN_PHONE_NUMBERS="+85589433443,089433443"

# Plasgate SMS Gateway (https://cloud.plasgate.com)
# Get your Private Key & Secret from: SMPP & API > SMS Gateway in Plasgate Dashboard
# SMS Gateway
PLASGATE_PRIVATE_KEY=""
PLASGATE_SECRET_KEY=""
PLASGATE_SENDER_NAME="SMS Info"

# ===== Staff Dashboard PINs (server-side check fallback) =====
# In production BOTH pins are REQUIRED: the server refuses to start without them.
# Outside production the defaults (1234 / 9999) are used if not provided.
STAFF_PIN="1234"
MANAGER_PIN="9999"

# ===== Browser origins allowed to call this API (CORS) =====
# Comma-separated list of exact origins.
# In production set: "https://menu.aichazhengdaarakawa.com,https://staff.aichazhengdaarakawa.com"
# Leave empty for dev defaults (http://localhost:5173,http://localhost:5174).
CORS_ORIGINS=""

# ===== ABA PayWay Integration =====
# Get these from your ABA PayWay merchant account (sandbox or production).
# Without real values, payment creation fails and only Cash checkout works.
ABA_MERCHANT_ID=""
ABA_API_KEY=""
ABA_BASE_URL="https://checkout-sandbox.payway.com.kh"
ABA_WEBHOOK_SECRET=""
ABA_WEBHOOK_URL=""

# ===== Cloudflare R2 Image Storage =====
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="aicha-menu-images"
R2_PUBLIC_URL=""