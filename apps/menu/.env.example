# ===== Telegram Login (browser access) =====
# Your bot's username WITHOUT the @ sign (example: AiChaMenuBot).
# Used by the "Log in with Telegram" button when the app is opened
# in a normal browser instead of inside Telegram.
VITE_BOT_NAME=""

# ===== API =====
# URL of the backend API (apps/api).
# For local development keep http://localhost:4000
VITE_API_URL="http://localhost:4000"
