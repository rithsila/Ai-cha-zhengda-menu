# ABA PayWay sandbox credentials
# Copy this file to ".env" and fill in your sandbox values.
# Get sandbox credentials at: https://sandbox.payway.com.kh/register-sandbox/
#
# ".env" is gitignored — never commit real credentials.

# Your sandbox merchant ID
ABA_MERCHANT_ID=your_sandbox_merchant_id

# Your sandbox API key (public key)
ABA_API_KEY=your_sandbox_api_key

# Sandbox base URL (use this exact value for sandbox testing)
ABA_BASE_URL=https://checkout-sandbox.payway.com.kh

# Webhook secret, used to verify webhook signatures (optional)
ABA_WEBHOOK_SECRET=your_sandbox_webhook_secret
