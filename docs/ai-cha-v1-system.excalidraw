    {
      "type": "text", "id": "b6_sub",
      "x": 1220, "y": 1992, "width": 900, "height": 18,
      "text": "POST /api/orders — points and order row commit in one prisma.$transaction.",
      "originalText": "POST /api/orders — points and order row commit in one prisma.$transaction.",
      "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid",
