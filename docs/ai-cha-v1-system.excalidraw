    {
      "type": "rectangle", "id": "money_rect",
      "x": 1220, "y": 2040, "width": 1060, "height": 250,
      "strokeColor": "#1e293b", "backgroundColor": "#1e293b",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid",
      "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 600010, "version": 1, "versionNonce": 600011,
      "isDeleted": false, "groupIds": [], "boundElements": null,
      "link": null, "locked": false, "roundness": {"type": 3}
    },
    {
      "type": "text", "id": "money_code",
      "x": 1240, "y": 2058, "width": 1020, "height": 215,
      "text": "// apps/api/src/index.ts — POST /api/orders\n\ndiscountApplied = min(user.loyaltyPoints / 100, totalAmount)  // 100 pts = $1\nfinalAmount     = totalAmount - discountApplied\npointsEarned    = floor(finalAmount * 10)                     // 10 pts per $1\n\nawait prisma.$transaction(async (tx) => {\n  if (usePoints)        loyaltyPoints decrement discountApplied * 100\n  if (finalAmount > 0)  loyaltyPoints increment pointsEarned\n  return tx.order.create({\n    pickupCode: `A-${Math.floor(100 + Math.random() * 900)}`,  // mock\n    status: 'pending', orderType, branchId, deliveryAddress\n  })\n})",
      "originalText": "// apps/api/src/index.ts — POST /api/orders\n\ndiscountApplied = min(user.loyaltyPoints / 100, totalAmount)  // 100 pts = $1\nfinalAmount     = totalAmount - discountApplied\npointsEarned    = floor(finalAmount * 10)                     // 10 pts per $1\n\nawait prisma.$transaction(async (tx) => {\n  if (usePoints)        loyaltyPoints decrement discountApplied * 100\n  if (finalAmount > 0)  loyaltyPoints increment pointsEarned\n  return tx.order.create({\n    pickupCode: `A-${Math.floor(100 + Math.random() * 900)}`,  // mock\n    status: 'pending', orderType, branchId, deliveryAddress\n  })\n})",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#22c55e", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid",
      "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 600012, "version": 1, "versionNonce": 600013,
      "isDeleted": false, "groupIds": [], "boundElements": null,
      "link": null, "locked": false, "containerId": null, "lineHeight": 1.25
    },
